DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/edolas_db"
APP_URL="http://localhost:3000"
GMAIL_USER="your-account@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"
EMAIL_FROM_NAME="EdolasSG"
NEXT_PUBLIC_DISCORD_URL="https://discord.gg/edolassg"
# Chỉ đặt tạm khi chạy `npm run db:bootstrap:owner`, sau đó xóa khỏi môi trường runtime.
EDOLAS_OWNER_EMAIL="owner@example.com"
EDOLAS_OWNER_PASSWORD="use-at-least-16-characters"
# Moi Paper backend dung mot server-id va key rieng. Dung `npm run minecraft:add-server` de tao an toan.
MINECRAFT_TELEMETRY_KEYS='{"survival-01":"replace-with-at-least-32-random-characters","survival-02":"replace-with-another-32-character-secret"}'
MINECRAFT_TELEMETRY_GROUPS='{"survival-01":"survival","survival-02":"survival"}'

# Thanh toan Store. Sandbox khong goi nha cung cap va khong nhan tien that.
STORE_PAYMENT_MODE="sandbox"
STORE_SANDBOX_ALLOW_DELIVERY="false"
APP_PUBLIC_URL="http://localhost:3000"
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"
